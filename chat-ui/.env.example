# MCP サーバー（Kong DP経由）のエンドポイント。Chat UIは両方へ同時に接続し、
# 片方だけ設定した場合や片方が落ちている場合は、もう片方だけで動く。
# クラスタ内から: Kong DPのService DNS + /mcp/<server名>
# ローカル(next dev)から検証する場合: minikube tunnel 経由の
# http://localhost/mcp/world-monthly-temperature と http://localhost/mcp/kong-insurance
MCP_WEATHER_URL=
MCP_INSURANCE_URL=

# 後方互換: MCP_WEATHER_URL が未設定の場合だけ、World Weather の接続先として使う
# MCP_SERVER_URL=

# Google Generative AI (Gemini) の APIキー。コードにハードコードしないこと。
# .env.local に書いてローカル実行し、本番相当はK8s Secret経由で渡す
# （deploy/README.md「Chat UI」節参照）。
GEMINI_API_KEY=

# 省略時は route.ts のデフォルト (gemini-3.5-flash) を使う
GEMINI_MODEL=gemini-3.5-flash
