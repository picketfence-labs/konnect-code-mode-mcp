{
  "openapi": "3.0.3",
  "info": {
    "title": "顧客サービス (Customer Service)",
    "description": "個人顧客マスタを提供するAPI。氏名・住所・連絡先・マイナンバー・口座情報を管理します。\n\n**マイナンバーの扱い:** 現バージョンでは`my_number`をフル桁でそのまま返却します。将来的に利用者の権限(ロール)に応じてraw/maskedを切り替える予定です。\n\nデモ用に bundle v0.1.1 から必要な操作だけを抽出した仕様です。",
    "version": "1.0.0"
  },
  "paths": {
    "/customers": {
      "get": {
        "tags": [
          "customers"
        ],
        "summary": "顧客一覧の取得",
        "operationId": "list_customers_customers_get",
        "parameters": [
          {
            "name": "prefecture",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "都道府県で絞り込み",
              "title": "Prefecture",
              "nullable": true
            },
            "description": "都道府県で絞り込み"
          },
          {
            "name": "gender",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "性別で絞り込み",
              "title": "Gender",
              "nullable": true
            },
            "description": "性別で絞り込み"
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/customers/{customer_id}": {
      "get": {
        "tags": [
          "customers"
        ],
        "summary": "顧客の取得",
        "operationId": "get_customer_customers__customer_id__get",
        "parameters": [
          {
            "name": "customer_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Customer Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BankAccount": {
        "properties": {
          "bank_name": {
            "type": "string",
            "title": "Bank Name",
            "description": "銀行名",
            "example": "みずほ銀行"
          },
          "branch_name": {
            "type": "string",
            "title": "Branch Name",
            "description": "支店名",
            "example": "渋谷支店"
          },
          "account_type": {
            "type": "string",
            "title": "Account Type",
            "description": "預金種別",
            "example": "普通"
          },
          "account_number": {
            "type": "string",
            "title": "Account Number",
            "description": "口座番号(7桁)",
            "example": "1234567"
          }
        },
        "type": "object",
        "required": [
          "bank_name",
          "branch_name",
          "account_type",
          "account_number"
        ],
        "title": "BankAccount"
      },
      "Customer": {
        "properties": {
          "last_name": {
            "type": "string",
            "title": "Last Name",
            "description": "姓",
            "example": "山田"
          },
          "first_name": {
            "type": "string",
            "title": "First Name",
            "description": "名",
            "example": "太郎"
          },
          "last_name_kana": {
            "type": "string",
            "title": "Last Name Kana",
            "description": "姓(全角カナ)",
            "example": "ヤマダ"
          },
          "first_name_kana": {
            "type": "string",
            "title": "First Name Kana",
            "description": "名(全角カナ)",
            "example": "タロウ"
          },
          "birth_date": {
            "type": "string",
            "title": "Birth Date",
            "description": "生年月日(YYYY-MM-DD)",
            "example": "1985-04-12"
          },
          "gender": {
            "type": "string",
            "title": "Gender",
            "description": "性別",
            "example": "男性"
          },
          "my_number": {
            "type": "string",
            "title": "My Number",
            "description": "マイナンバー(12桁・ダミー)",
            "example": "123456789018"
          },
          "postal_code": {
            "type": "string",
            "title": "Postal Code",
            "description": "郵便番号(NNN-NNNN)",
            "example": "150-0002"
          },
          "prefecture": {
            "type": "string",
            "title": "Prefecture",
            "description": "都道府県",
            "example": "東京都"
          },
          "city": {
            "type": "string",
            "title": "City",
            "description": "市区町村",
            "example": "渋谷区"
          },
          "address_line": {
            "type": "string",
            "title": "Address Line",
            "description": "番地・建物名",
            "example": "1-2-3 パークタワー"
          },
          "phone_number": {
            "type": "string",
            "title": "Phone Number",
            "description": "固定電話番号",
            "nullable": true
          },
          "mobile_number": {
            "type": "string",
            "title": "Mobile Number",
            "description": "携帯電話番号",
            "example": "090-1234-5678"
          },
          "email": {
            "type": "string",
            "title": "Email",
            "description": "メールアドレス",
            "example": "taro@example.com"
          },
          "occupation": {
            "type": "string",
            "title": "Occupation",
            "description": "職業",
            "nullable": true
          },
          "annual_income": {
            "type": "integer",
            "title": "Annual Income",
            "description": "年収(円)",
            "nullable": true
          },
          "bank_account": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BankAccount"
              }
            ],
            "description": "口座情報",
            "nullable": true
          },
          "customer_since": {
            "type": "string",
            "title": "Customer Since",
            "description": "顧客登録日(YYYY-MM-DD)"
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id",
            "description": "顧客ID(CUS-NNNNNN)",
            "example": "CUS-000001"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "last_name",
          "first_name",
          "last_name_kana",
          "first_name_kana",
          "birth_date",
          "gender",
          "my_number",
          "postal_code",
          "prefecture",
          "city",
          "address_line",
          "mobile_number",
          "email",
          "customer_since",
          "customer_id",
          "created_at",
          "updated_at"
        ],
        "title": "Customer"
      },
      "CustomerList": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Customer"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "total",
          "items"
        ],
        "title": "CustomerList"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "customers",
      "description": "顧客マスタの参照・管理"
    }
  ],
  "servers": [
    {
      "url": "http://customer.insurance.svc.cluster.local:8000",
      "description": "Insurance API サービスへのクラスタ内接続先です。"
    }
  ]
}
