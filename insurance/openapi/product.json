{
  "openapi": "3.0.3",
  "info": {
    "title": "商品サービス (Product Service)",
    "description": "損害保険商品マスタを提供するAPI。火災・自動車・傷害・医療・ペットの各保険商品を管理します。\n\nデモ用に bundle v0.1.1 から必要な操作だけを抽出した仕様です。",
    "version": "1.0.0"
  },
  "paths": {
    "/products": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "商品一覧の取得",
        "operationId": "list_products_products_get",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "商品カテゴリで絞り込み",
              "title": "Category",
              "nullable": true
            },
            "description": "商品カテゴリで絞り込み"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "販売状況で絞り込み",
              "title": "Status",
              "nullable": true
            },
            "description": "販売状況で絞り込み"
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/products/{product_id}": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "商品の取得",
        "operationId": "get_product_products__product_id__get",
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Product Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PremiumRateTable": {
        "properties": {
          "annual_rate_on_sum_insured": {
            "type": "number",
            "title": "Annual Rate On Sum Insured",
            "description": "保険金額に対する年間保険料率"
          },
          "annual_base_premium": {
            "type": "integer",
            "title": "Annual Base Premium",
            "description": "年間ベース保険料(円)"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "description": "補足",
            "nullable": true
          }
        },
        "type": "object",
        "required": [
          "annual_rate_on_sum_insured",
          "annual_base_premium"
        ],
        "title": "PremiumRateTable"
      },
      "Product": {
        "properties": {
          "product_code": {
            "type": "string",
            "title": "Product Code",
            "description": "社内商品コード",
            "example": "FIRE-STD"
          },
          "product_name": {
            "type": "string",
            "title": "Product Name",
            "description": "商品名(愛称含む)",
            "example": "火災保険「住まいの安心」"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "description": "商品カテゴリ",
            "example": "火災保険"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "商品説明文"
          },
          "coverage_summary": {
            "type": "string",
            "title": "Coverage Summary",
            "description": "主契約の保障内容概要"
          },
          "min_age": {
            "type": "integer",
            "title": "Min Age",
            "description": "加入可能な最低年齢",
            "example": 18
          },
          "max_age": {
            "type": "integer",
            "title": "Max Age",
            "description": "加入可能な最高年齢",
            "example": 99
          },
          "policy_term": {
            "type": "string",
            "title": "Policy Term",
            "description": "保険期間",
            "example": "1〜5年"
          },
          "min_sum_insured": {
            "type": "integer",
            "title": "Min Sum Insured",
            "description": "保険金額の下限(円)"
          },
          "max_sum_insured": {
            "type": "integer",
            "title": "Max Sum Insured",
            "description": "保険金額の上限(円)"
          },
          "premium_rate_table": {
            "$ref": "#/components/schemas/PremiumRateTable",
            "description": "保険料算出係数"
          },
          "riders": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Riders",
            "description": "付帯可能な特約一覧"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "販売状況",
            "example": "販売中"
          },
          "product_id": {
            "type": "string",
            "title": "Product Id",
            "description": "商品ID(PRD-NNN)",
            "example": "PRD-001"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "product_code",
          "product_name",
          "category",
          "description",
          "coverage_summary",
          "min_age",
          "max_age",
          "policy_term",
          "min_sum_insured",
          "max_sum_insured",
          "premium_rate_table",
          "status",
          "product_id",
          "created_at",
          "updated_at"
        ],
        "title": "Product"
      },
      "ProductList": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "total",
          "items"
        ],
        "title": "ProductList"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "products",
      "description": "商品マスタの参照・管理"
    }
  ],
  "servers": [
    {
      "url": "http://product.insurance.svc.cluster.local:8000",
      "description": "Insurance API サービスへのクラスタ内接続先です。"
    }
  ]
}
