{
  "openapi": "3.0.3",
  "info": {
    "title": "保険料試算サービス (Simulation Service)",
    "description": "保険料を試算するステートレスAPI。データは永続化せず、入力に応じて都度計算します。契約(policy)サービスの保険料と同一の算出ロジックを用います。\n\nデモ用に bundle v0.1.1 から必要な操作だけを抽出した仕様です。",
    "version": "1.0.0"
  },
  "paths": {
    "/simulations": {
      "post": {
        "tags": [
          "simulation"
        ],
        "summary": "保険料の試算",
        "operationId": "simulate_simulations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Breakdown": {
        "properties": {
          "base_annual": {
            "type": "integer",
            "title": "Base Annual",
            "description": "年間ベース保険料(円)"
          },
          "variable_annual": {
            "type": "integer",
            "title": "Variable Annual",
            "description": "保険金額比例部分の年間保険料(円)"
          },
          "smoker_surcharge": {
            "type": "integer",
            "title": "Smoker Surcharge",
            "description": "喫煙割増(円)"
          },
          "age_factor": {
            "type": "number",
            "title": "Age Factor",
            "description": "年齢係数"
          }
        },
        "type": "object",
        "required": [
          "base_annual",
          "variable_annual",
          "smoker_surcharge",
          "age_factor"
        ],
        "title": "Breakdown"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SimulationRequest": {
        "properties": {
          "product_id": {
            "type": "string",
            "title": "Product Id",
            "description": "試算対象商品(商品ID)",
            "example": "PRD-004"
          },
          "birth_date": {
            "type": "string",
            "title": "Birth Date",
            "description": "生年月日(YYYY-MM-DD)。年齢計算に使用",
            "example": "1985-04-12"
          },
          "gender": {
            "type": "string",
            "title": "Gender",
            "description": "性別",
            "default": "回答しない",
            "example": "男性"
          },
          "sum_insured": {
            "type": "integer",
            "title": "Sum Insured",
            "description": "希望保険金額(円)",
            "example": 3000000
          },
          "payment_period": {
            "type": "string",
            "title": "Payment Period",
            "description": "払込期間",
            "example": "1年（自動更新）",
            "nullable": true
          },
          "smoker_flag": {
            "type": "boolean",
            "title": "Smoker Flag",
            "description": "喫煙の有無(医療・傷害保険で保険料に影響)",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "birth_date",
          "sum_insured"
        ],
        "title": "SimulationRequest"
      },
      "SimulationResponse": {
        "properties": {
          "product_id": {
            "type": "string",
            "title": "Product Id"
          },
          "product_name": {
            "type": "string",
            "title": "Product Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "age": {
            "type": "integer",
            "title": "Age",
            "description": "試算基準日時点の年齢"
          },
          "sum_insured": {
            "type": "integer",
            "title": "Sum Insured"
          },
          "monthly_premium": {
            "type": "integer",
            "title": "Monthly Premium",
            "description": "月額保険料(円)"
          },
          "annual_premium": {
            "type": "integer",
            "title": "Annual Premium",
            "description": "年額保険料(円)"
          },
          "breakdown": {
            "$ref": "#/components/schemas/Breakdown"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "product_name",
          "category",
          "age",
          "sum_insured",
          "monthly_premium",
          "annual_premium",
          "breakdown"
        ],
        "title": "SimulationResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "simulation",
      "description": "保険料の試算"
    }
  ],
  "servers": [
    {
      "url": "http://simulation.insurance.svc.cluster.local:8000",
      "description": "Insurance API サービスへのクラスタ内接続先です。"
    }
  ]
}
