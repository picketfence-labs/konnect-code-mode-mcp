2026-09-29T06:50:37.864904588Z     sorted_totals = sorted(product_paid_totals.items(), key=lambda x: x[1], reverse=True)
2026-09-29T06:50:37.864908171Z     
2026-09-29T06:50:37.864909254Z     return sorted_totals[:5]
